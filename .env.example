# Database Configuration
# 本システムのオブジェクトは NAM_IAM_ADMIN スキーマ所有。アプリは NAM_IAM_ADMIN で接続する。
DB_USER=NAM_IAM_ADMIN
DB_PASSWORD=your_password_here
DB_HOST=your_oracle_host
DB_PORT=1521
DB_SERVICE=your_service_name

# Security Configuration
ALLOWED_NAISETSU_CODES=1234,5678,9012

# Authentication (Azure App Service / Entra ID Easy Auth)
# Entra ID の UPN からこのドメインを除いた部分を e_imdb2_users.USER_CD と照合する
AUTH_EMAIL_DOMAIN=@nam.co.jp
# ローカル開発（FLASK_ENV=development）で認証バイパス時に使うログインユーザーCD
DEV_LOGIN_USER_CD=devuser

# Flask Configuration
SECRET_KEY=your_secret_key_here
# development の場合、Easy Auth ヘッダが無くても認証をバイパスして動作する
FLASK_ENV=development
FLASK_DEBUG=True

# Upload Configuration
UPLOAD_FOLDER=/tmp/uploads
MAX_UPLOAD_SIZE=104857600

# Google Sheets API (OAuth2)
GOOGLE_CREDENTIALS_JSON=./client_secret.json
GOOGLE_OAUTH2_TOKEN_FILE=./token.json
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Proxy Configuration (optional, set if behind corporate proxy)
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=http://proxy.example.com:8080
